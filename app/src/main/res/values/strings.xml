    <!-- Privacy Policy Dialog -->
    <string name="privacy_policy">Privacy Policy</string>
    <string name="privacy_policy_title">Privacy &amp; Data Policy</string>
    <string name="privacy_policy_content">AmbientDeck is designed with complete privacy in mind. We do not collect, store, track, or share any personal data or device identifiers. Weather telemetry is fetched anonymously via Open-Meteo for your selected location coordinates. Airspace flight data is retrieved from public OpenSky feeds. Crypto tickers are retrieved directly from public Binance endpoints. All user preferences remain solely on your device.</string>
    <string name="privacy_bullet_zero_data_title">Zero Data Collection</string>
    <string name="privacy_bullet_zero_data_desc">No analytics trackers, advertising IDs, or telemetry profiling.</string>
    <string name="privacy_bullet_open_apis_title">Open Free APIs</string>
    <string name="privacy_bullet_open_apis_desc">Live data comes from public Open-Meteo, Binance, and OpenSky Network.</string>
    <string name="privacy_bullet_local_storage_title">Local Device Storage</string>
    <string name="privacy_bullet_local_storage_desc">Preferences and locations stay strictly on your local device.</string>
    <string name="privacy_policy_ok">Understood</string>

