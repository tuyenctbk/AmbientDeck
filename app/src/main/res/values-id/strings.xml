    <string name="privacy_policy">Kebijakan Privasi</string>
    <string name="privacy_policy_title">Kebijakan Data dan Privasi</string>
    <string name="privacy_policy_content">AmbientDeck dirancang dengan privasi menyeluruh. Kami tidak mengumpulkan, menyimpan, melacak, atau membagikan data pribadi atau identitas perangkat. Data cuaca diperoleh secara anonim via Open-Meteo, data penerbangan dari umpan publik OpenSky, dan harga kripto dari API publik Binance. Semua pengaturan Anda tersimpan secara lokal di perangkat Anda.</string>
    <string name="privacy_policy_ok">Mengerti</string>
