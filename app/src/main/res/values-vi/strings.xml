    <string name="privacy_policy">Chính sách bảo mật</string>
    <string name="privacy_policy_title">Chính sách dữ liệu và bảo mật</string>
    <string name="privacy_policy_content">AmbientDeck được thiết kế với sự tôn trọng tuyệt đối quyền riêng tư. Chúng tôi không thu thập, không lưu trữ, không theo dõi và không chia sẻ bất kỳ thông tin cá nhân hay định danh thiết bị nào. Dữ liệu thời tiết được truy vấn ẩn danh qua Open-Meteo. Dữ liệu chuyến bay từ OpenSky công khai. Tỷ giá tiền số lấy trực tiếp từ Binance. Mọi cài đặt của bạn lưu trữ duy nhất trên thiết bị.</string>
    <string name="privacy_policy_ok">Đã hiểu</string>

